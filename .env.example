# --- Database ---
POSTGRES_DB=matmuhDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://matmuh-db:5432/matmuhDB
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Server ---
SERVER_PORT=9001
API_URL=https://matmuh.yusufacmaci.com
SECURITY_LOG_LEVEL=INFO

# --- JWT ---
JWT_SECRET=generate-a-long-random-base64-secret
JWT_ACCESS_VALIDITY_SECONDS=3600
JWT_REFRESH_VALIDITY_DAYS=30

# --- Azure OAuth2 ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:3000/api/login/oauth2/code/azure
FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# --- Cookie (frontend ile aynı origin ise Lax; farklı origin ise None + cookie ile yazma kapanır) ---
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=true

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://matmuh.vercel.app,https://matmuhadmin.vercel.app,https://matmuh.yusufacmaci.com,https://matmuh.yildiz.edu.tr

# --- Storage (local | s3) ---
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=uploads

# Public dosyalar bu tabandan servis edilir (CloudFront'a proxy'lenen /cdn yolu)
STORAGE_DOMAIN=https://matmuh.yildiz.edu.tr/cdn
# /cdn yolunu ters vekil sunucuda CDN'e proxy'leyemiyorsan doldur: backend 301 ile CDN'e yonlendirir.
# Ters vekilde proxy kuruluysa bos birak.
CDN_ORIGIN=https://d1af82hh4ladho.cloudfront.net

# --- S3 (STORAGE_TYPE=s3 iken zorunlu) ---
STORAGE_BUCKET=matmuh-211125416621-eu-central-1-an
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Korumali dosya linklerinin gecerlilik suresi (dakika)
STORAGE_SIGNED_URL_MINUTES=15d
# Sadece S3 uyumlu baska bir servis icin (R2/MinIO); AWS S3'te bos birak
STORAGE_ENDPOINT=

# --- Upload limits ---
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# blank on production
FRONTEND_ALLOWED_CALLBACKS=

# Frontend cache revalidation after writes; the secret matches the frontend CMS_REVALIDATE_SECRET.
REVALIDATION_URL=https://matmuh.yildiz.edu.tr/cms-revalidate
REVALIDATION_SECRET=
